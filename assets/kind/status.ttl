@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# The `status` node kind. Closed: a property not named here is refused. Its fallback text, what a
# target that cannot draw the kind shows instead, is `content`, which every `status` must carry.
<urn:iki:ui:kind:name:status> a sh:NodeShape, rdfs:Class ;
  rdfs:subClassOf <urn:iki:ui:node> ;
  rdfs:label "status" ;
  <urn:iki:ui:property:name:fallback> <urn:iki:ui:property:name:content> ;
  sh:targetClass <urn:iki:ui:kind:name:status> ;
  sh:closed true ;
  sh:property <urn:iki:ui:kind:name:status:property:type>, <urn:iki:ui:kind:name:status:property:content> .

<urn:iki:ui:kind:name:status:property:type> sh:path rdf:type ; sh:hasValue <urn:iki:ui:kind:name:status> ; sh:maxCount 1 .
<urn:iki:ui:kind:name:status:property:content> sh:path <urn:iki:ui:property:name:content> ; sh:maxCount 1 ; sh:minCount 1 ; sh:datatype xsd:string ; sh:minLength 1 .
