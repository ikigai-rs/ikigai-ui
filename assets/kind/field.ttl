@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# The `field` node kind. Closed: a property not named here is refused. Its fallback text, what a
# target that cannot draw the kind shows instead, is `label`, which every `field` must carry.
<urn:iki:ui:kind:name:field> a sh:NodeShape, rdfs:Class ;
  rdfs:subClassOf <urn:iki:ui:node> ;
  rdfs:label "field" ;
  <urn:iki:ui:property:name:fallback> <urn:iki:ui:property:name:label> ;
  sh:targetClass <urn:iki:ui:kind:name:field> ;
  sh:closed true ;
  sh:property <urn:iki:ui:kind:name:field:property:name:type>, <urn:iki:ui:kind:name:field:property:name:label>, <urn:iki:ui:kind:name:field:property:name:name>, <urn:iki:ui:kind:name:field:property:name:input>, <urn:iki:ui:kind:name:field:property:name:value>, <urn:iki:ui:kind:name:field:property:name:required>, <urn:iki:ui:kind:name:field:property:name:description>, <urn:iki:ui:kind:name:field:property:name:error> .

<urn:iki:ui:kind:name:field:property:name:type> sh:path rdf:type ; sh:hasValue <urn:iki:ui:kind:name:field> ; sh:maxCount 1 .
<urn:iki:ui:kind:name:field:property:name:label> sh:path <urn:iki:ui:property:name:label> ; sh:maxCount 1 ; sh:minCount 1 ; sh:datatype xsd:string ; sh:minLength 1 .
<urn:iki:ui:kind:name:field:property:name:name> sh:path <urn:iki:ui:property:name:name> ; sh:maxCount 1 ; sh:minCount 1 ; sh:datatype xsd:string ; sh:minLength 1 .
<urn:iki:ui:kind:name:field:property:name:input> sh:path <urn:iki:ui:property:name:input> ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 .
<urn:iki:ui:kind:name:field:property:name:value> sh:path <urn:iki:ui:property:name:value> ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 .
<urn:iki:ui:kind:name:field:property:name:required> sh:path <urn:iki:ui:property:name:required> ; sh:maxCount 1 ; sh:in ( true false "true" "false" ) .
<urn:iki:ui:kind:name:field:property:name:description> sh:path <urn:iki:ui:property:name:description> ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 .
<urn:iki:ui:kind:name:field:property:name:error> sh:path <urn:iki:ui:property:name:error> ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 .
