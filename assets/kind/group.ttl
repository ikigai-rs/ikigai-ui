@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# The `group` node kind. Closed: a property not named here is refused. Its fallback text, what a
# target that cannot draw the kind shows instead, is `label`, which every `group` must carry.
<urn:iki:ui:kind:name:group> a sh:NodeShape, rdfs:Class ;
  rdfs:subClassOf <urn:iki:ui:node> ;
  rdfs:label "group" ;
  <urn:iki:ui:property:name:fallback> <urn:iki:ui:property:name:label> ;
  sh:targetClass <urn:iki:ui:kind:name:group> ;
  sh:closed true ;
  sh:property <urn:iki:ui:kind:name:group:property:name:replacement>, <urn:iki:ui:kind:name:group:property:name:type>, <urn:iki:ui:kind:name:group:property:name:label>, <urn:iki:ui:kind:name:group:property:name:header>, <urn:iki:ui:kind:name:group:property:name:child> .

<urn:iki:ui:kind:name:group:property:name:type> sh:path rdf:type ; sh:hasValue <urn:iki:ui:kind:name:group> ; sh:maxCount 1 .
<urn:iki:ui:kind:name:group:property:name:label> sh:path <urn:iki:ui:property:name:label> ; sh:maxCount 1 ; sh:minCount 1 ; sh:datatype xsd:string ; sh:minLength 1 .
# `header`, on a table's row: `column` (its cells head the columns) or `row` (its first cell heads it).
<urn:iki:ui:kind:name:group:property:name:header> sh:path <urn:iki:ui:property:name:header> ; sh:maxCount 1 ; sh:in ( "column" "row" ) .
<urn:iki:ui:kind:name:group:property:name:child> sh:path <urn:iki:ui:property:name:child> ; sh:class <urn:iki:ui:node> .

# Optional replacement subtree, validated by its own kind shape.
<urn:iki:ui:kind:name:group:property:name:replacement> sh:path <urn:iki:ui:property:name:replacement> ;
  sh:maxCount 1 ; sh:class <urn:iki:ui:node> .

# Its accessibility acceptance criteria, one per target (ledger #3542): what each face emits, its
# keys, what a screen reader announces, and the SEE and HEAR checks (urn:iki:ui:shape:criterion).
<urn:iki:ui:kind:name:group> <urn:iki:ui:criterion:term:criterion> <urn:iki:ui:criterion:kind:group:target:html>, <urn:iki:ui:criterion:kind:group:target:gpui> .
