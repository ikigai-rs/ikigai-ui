@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# The `visual` node kind. Closed: a property not named here is refused. Its fallback text, what a
# target that cannot draw the kind shows instead, is `label`, which every `visual` must carry.
<urn:iki:ui:kind:name:visual> a sh:NodeShape, rdfs:Class ;
  rdfs:subClassOf <urn:iki:ui:node> ;
  rdfs:label "visual" ;
  <urn:iki:ui:property:name:fallback> <urn:iki:ui:property:name:label> ;
  sh:targetClass <urn:iki:ui:kind:name:visual> ;
  sh:closed true ;
  sh:property <urn:iki:ui:kind:name:visual:property:name:fallback>, <urn:iki:ui:kind:name:visual:property:name:type>, <urn:iki:ui:kind:name:visual:property:name:label>, <urn:iki:ui:kind:name:visual:property:name:description> .

<urn:iki:ui:kind:name:visual:property:name:type> sh:path rdf:type ; sh:hasValue <urn:iki:ui:kind:name:visual> ; sh:maxCount 1 .
<urn:iki:ui:kind:name:visual:property:name:label> sh:path <urn:iki:ui:property:name:label> ; sh:maxCount 1 ; sh:minCount 1 ; sh:datatype xsd:string ; sh:minLength 1 .
<urn:iki:ui:kind:name:visual:property:name:description> sh:path <urn:iki:ui:property:name:description> ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 .

# Optional replacement subtree, validated by its own kind shape.
<urn:iki:ui:kind:name:visual:property:name:fallback> sh:path <urn:iki:ui:property:name:fallback> ;
  sh:maxCount 1 ; sh:class <urn:iki:ui:node> .
