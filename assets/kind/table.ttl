@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# The `table` node kind. Closed: a property not named here is refused. Its fallback text, what a
# target that cannot draw the kind shows instead, is `caption`, which every `table` must carry.
<urn:iki:ui:kind:name:table> a sh:NodeShape, rdfs:Class ;
  rdfs:subClassOf <urn:iki:ui:node> ;
  rdfs:label "table" ;
  <urn:iki:ui:property:name:fallback> <urn:iki:ui:property:name:caption> ;
  sh:targetClass <urn:iki:ui:kind:name:table> ;
  sh:closed true ;
  sh:property <urn:iki:ui:kind:name:table:property:type>, <urn:iki:ui:kind:name:table:property:caption>, <urn:iki:ui:kind:name:table:property:child> .

<urn:iki:ui:kind:name:table:property:type> sh:path rdf:type ; sh:hasValue <urn:iki:ui:kind:name:table> ; sh:maxCount 1 .
<urn:iki:ui:kind:name:table:property:caption> sh:path <urn:iki:ui:property:name:caption> ; sh:maxCount 1 ; sh:minCount 1 ; sh:datatype xsd:string ; sh:minLength 1 .
<urn:iki:ui:kind:name:table:property:child> sh:path <urn:iki:ui:property:name:child> ; sh:class <urn:iki:ui:kind:name:group> .
