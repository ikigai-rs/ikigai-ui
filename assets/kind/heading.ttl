@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# The `heading` node kind. Closed: a property not named here is refused. Its fallback text, what a
# target that cannot draw the kind shows instead, is `content`, which every `heading` must carry.
<urn:iki:ui:kind:name:heading> a sh:NodeShape, rdfs:Class ;
  rdfs:subClassOf <urn:iki:ui:node> ;
  rdfs:label "heading" ;
  <urn:iki:ui:property:name:fallback> <urn:iki:ui:property:name:content> ;
  sh:targetClass <urn:iki:ui:kind:name:heading> ;
  sh:closed true ;
  sh:property <urn:iki:ui:shape:name:node-fallback>, <urn:iki:ui:kind:name:heading:property:type>, <urn:iki:ui:kind:name:heading:property:content>, <urn:iki:ui:kind:name:heading:property:level> .

<urn:iki:ui:kind:name:heading:property:type> sh:path rdf:type ; sh:hasValue <urn:iki:ui:kind:name:heading> ; sh:maxCount 1 .
<urn:iki:ui:kind:name:heading:property:content> sh:path <urn:iki:ui:property:name:content> ; sh:maxCount 1 ; sh:minCount 1 ; sh:datatype xsd:string ; sh:minLength 1 .
<urn:iki:ui:kind:name:heading:property:level> sh:path <urn:iki:ui:property:name:level> ; sh:maxCount 1 ; sh:minCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:maxInclusive 6 .
