@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# The `image` node kind. Closed: a property not named here is refused. Its fallback text, what a
# target that cannot draw the kind shows instead, is `alt`, which every `image` must carry.
<urn:iki:ui:kind:name:image> a sh:NodeShape, rdfs:Class ;
  rdfs:subClassOf <urn:iki:ui:node> ;
  rdfs:label "image" ;
  <urn:iki:ui:property:name:fallback> <urn:iki:ui:property:name:alt> ;
  sh:targetClass <urn:iki:ui:kind:name:image> ;
  sh:closed true ;
  sh:property <urn:iki:ui:kind:name:image:property:name:fallback>, <urn:iki:ui:kind:name:image:property:name:type>, <urn:iki:ui:kind:name:image:property:name:alt>, <urn:iki:ui:kind:name:image:property:name:src> .

<urn:iki:ui:kind:name:image:property:name:type> sh:path rdf:type ; sh:hasValue <urn:iki:ui:kind:name:image> ; sh:maxCount 1 .
<urn:iki:ui:kind:name:image:property:name:alt> sh:path <urn:iki:ui:property:name:alt> ; sh:maxCount 1 ; sh:minCount 1 ; sh:datatype xsd:string ; sh:minLength 1 .
<urn:iki:ui:kind:name:image:property:name:src> sh:path <urn:iki:ui:property:name:src> ; sh:maxCount 1 ; sh:minCount 1 ; sh:datatype xsd:string ; sh:minLength 1 .

# Optional replacement subtree, validated by its own kind shape.
<urn:iki:ui:kind:name:image:property:name:fallback> sh:path <urn:iki:ui:property:name:fallback> ;
  sh:maxCount 1 ; sh:class <urn:iki:ui:node> .
