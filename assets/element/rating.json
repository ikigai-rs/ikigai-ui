{
  "arguments": [
    {
      "name": "label",
      "summary": "what is rated",
      "required": true
    },
    {
      "name": "score",
      "summary": "the rating",
      "required": true
    },
    {
      "name": "out-of",
      "summary": "the best rating",
      "required": false,
      "default": "5"
    }
  ],
  "expansion": {
    "kind": "group",
    "properties": {
      "label": "{label}"
    },
    "children": [
      {
        "kind": "text",
        "properties": {
          "content": "{label}: {score} out of {out-of}"
        }
      },
      "{children}"
    ]
  }
}
