# The fields and the topics a message may have, grouped by their type.
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <http://schema.org/>
SELECT ?focus ?group ?item ?label WHERE {
  GRAPH ?focus {
    ?item a ?type ; rdfs:label ?label .
    FILTER(?type IN (schema:PropertyValueSpecification, schema:Enumeration))
  }
  BIND(IF(?type = schema:Enumeration, "Topics", "Fields") AS ?group)
}
ORDER BY ?group ?label
