PREFIX k: <urn:iki:ui:fixture:knowledge:>
PREFIX oa: <http://www.w3.org/ns/oa#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?focus ?entity ?section ?item ?label ?annotation ?source ?document ?quote ?start ?end WHERE {
  ?focus rdfs:label ?entity .
  {
    BIND("Accepted facts" AS ?section)
    ?focus k:acceptedFact ?item .
    ?item rdf:value ?label .
    OPTIONAL {
      ?item k:citation ?annotation .
      ?annotation a oa:Annotation ; oa:hasTarget ?target .
      ?target oa:hasSource ?source ; oa:hasSelector ?quoted, ?position .
      ?quoted a oa:TextQuoteSelector ; oa:exact ?quote .
      ?position a oa:TextPositionSelector ; oa:start ?start ; oa:end ?end .
      OPTIONAL { ?source rdfs:label ?title }
      BIND(COALESCE(?title, STR(?source)) AS ?document)
    }
  } UNION {
    BIND("Neighborhood" AS ?section)
    ?focus k:neighbor ?item .
    OPTIONAL { ?item rdfs:label ?name }
    BIND(COALESCE(?name, STR(?item)) AS ?label)
  }
}
ORDER BY ?section ?item ?annotation ?source ?start ?end ?quote
