# The contact contract's labeled nodes and the links between them, for the scene and the
# selection beside it.
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
CONSTRUCT { ?node rdfs:label ?label . ?node ?p ?o } WHERE {
  GRAPH ?focus {
    ?node rdfs:label ?label .
    OPTIONAL { ?node ?p ?o . FILTER(isIRI(?o)) }
  }
}
