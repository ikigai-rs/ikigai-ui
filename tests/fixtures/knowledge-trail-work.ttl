	oa:hasSource <urn:iki:ledger:default:comment:4b> .
<urn:knowledge:trail:corpus:work#claim-2> a oa:Annotation ;
	oa:bodyValue "The migration of old graphs is still open." ;
	oa:hasTarget <urn:knowledge:trail:corpus:work#claim-2-target> ;
