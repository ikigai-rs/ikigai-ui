@prefix oa: <http://www.w3.org/ns/oa#> .
<urn:knowledge:trail:corpus:work#claim-1-position> a oa:TextPositionSelector ;
	oa:end "63"^^<http://www.w3.org/2001/XMLSchema#nonNegativeInteger> ;
	oa:start "9"^^<http://www.w3.org/2001/XMLSchema#nonNegativeInteger> .
<urn:knowledge:trail:corpus:work#claim-1-quote> a oa:TextQuoteSelector ;
	oa:exact "we adopt oxigraph, since it already backs ikigai-store" .
<urn:knowledge:trail:corpus:work#claim-1-target> a oa:SpecificResource ;
	oa:hasSelector <urn:knowledge:trail:corpus:work#claim-1-position> , <urn:knowledge:trail:corpus:work#claim-1-quote> ;
	oa:hasSource <urn:iki:ledger:default:comment:4a> .
<urn:knowledge:trail:corpus:work#claim-1> a oa:Annotation ;
	oa:bodyValue "Brian decided to adopt oxigraph, on the item's first comment." ;
	oa:hasTarget <urn:knowledge:trail:corpus:work#claim-1-target> ;
	oa:motivatedBy oa:describing .
<urn:knowledge:trail:corpus:work#claim-2-position> a oa:TextPositionSelector ;
